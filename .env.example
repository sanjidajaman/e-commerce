# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/ecommerce
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# ---- JWT ----
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRE=30d

# ---- Client ----
# Used for CORS and for building links in emails (password reset, etc.)
CLIENT_URL=http://localhost:5173

# ---- Email (optional) ----
# If left blank, emails are logged to the server console instead of sent -
# useful for local development without a real mail provider.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="E-Shop <noreply@eshop.com>"

# ---- Rate limiting ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
